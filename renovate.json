{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edithatogo/renovate-config",
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":disableRateLimiting",
    "group:allNonMajor",
    "group:monorepos",
    "group:recommended"
  ],
  "enabledManagers": [
    "cargo",
    "custom.regex",
    "github-actions",
    "npm",
    "pep621",
    "pip_requirements",
    "pip_setup",
    "git-submodules"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update CRAN minimum versions in the R DESCRIPTION",
      "managerFilePatterns": [
        "/^r-package/voiageR/DESCRIPTION$/"
      ],
      "matchStrings": [
        "(?<depName>reticulate) \\(>= (?<currentValue>[^)]+)\\)",
        "(?<depName>knitr) \\(>= (?<currentValue>[^)]+)\\)",
        "(?<depName>rmarkdown) \\(>= (?<currentValue>[^)]+)\\)",
        "(?<depName>testthat) \\(>= (?<currentValue>[^)]+)\\)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{#if (equals depName 'reticulate')}}rstudio/reticulate{{else}}{{#if (equals depName 'knitr')}}yihui/knitr{{else}}{{#if (equals depName 'rmarkdown')}}rstudio/rmarkdown{{else}}r-lib/testthat{{/if}}{{/if}}{{/if}}",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update non-stdlib Julia compatibility bounds",
      "managerFilePatterns": [
        "/^bindings/julia/Project.toml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)(?<depName>Aqua) = \"(?<currentValue>[^\"]+)\"",
        "(?:^|\\n)(?<depName>JSON) = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{#if (equals depName 'Aqua')}}JuliaTesting/Aqua.jl{{else}}JuliaIO/JSON.jl{{/if}}",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "schedule": [
    "every weekend"
  ],
  "minimumReleaseAge": "14 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "packageRules": [
    {
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip_setup"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python dependencies",
      "groupSlug": "python-all"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "rangeStrategy": "bump",
      "automerge": false,
      "labels": [
        "dependencies",
        "polyglot"
      ]
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "jax-ecosystem"
      ],
      "matchPackageNames": [
        "/^jax(?:lib)?$/",
        "numpyro"
      ]
    },
    {
      "groupName": "testing dependencies",
      "groupSlug": "testing",
      "matchPackageNames": [
        "/^pytest(?:-|$)/",
        "hypothesis",
        "coverage"
      ]
    },
    {
      "groupName": "linting and type checking",
      "groupSlug": "linting",
      "matchPackageNames": [
        "ruff",
        "ty"
      ]
    },
    {
      "description": "Preserve published library compatibility ranges; exact environments belong in lockfiles",
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip_setup",
        "cargo"
      ],
      "rangeStrategy": "auto",
      "automerge": false
    },
    {
      "description": "Do not replace supported interpreter, toolchain and engine ranges with exact pins",
      "matchDatasources": [
        "python-version",
        "node-version",
        "rust-version"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "Keep the supported Node engine range; review engine floor changes explicitly",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "description": "Preserve immutable recorded reproduction and frontier environments",
      "matchFileNames": [
        "paper/reproduction-environment/**",
        "specs/submission-readiness/dependency-frontier-environment-20260829/**"
      ],
      "enabled": false
    },
    {
      "description": "Keep the declared Rust MSRV and its release qualification lanes at 1.85; upgrades require compatibility-policy review",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "rust-version"
      ],
      "matchCurrentVersion": "/^1\\.85(?:\\.0)?$/",
      "enabled": false
    },
    {
      "description": "Keep Python 3.12 ABI-floor and compatibility lanes; interpreter policy changes require explicit review",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "python-version"
      ],
      "matchCurrentVersion": "/^3\\.12(?:\\.\\d+)?$/",
      "enabled": false
    },
    {
      "description": "Review executable source and lock changes through pull requests",
      "matchManagers": [
        "git-submodules",
        "github-actions",
        "npm",
        "cargo",
        "pep621",
        "pip_requirements",
        "pip_setup",
        "custom.regex"
      ],
      "automerge": false,
      "automergeType": "pr"
    }
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "rangeStrategy": "auto",
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "timezone": "Etc/UTC",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "every weekend"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
