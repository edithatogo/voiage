easyblock = "PythonBundle"
name = "SciPy-bundle"
version = "2026.09"
versionsuffix = "-voiage-2.2.0"
homepage = "https://python.org/"
description = "Source-pinned scientific providers within Voiage 2.2.0 bounds."
toolchain = {"name": "gfbf", "version": "2023a"}
toolchainopts = {"pic": True, "lowopt": True}
builddependencies = [
    ("hypothesis", "6.103.1"),
    ("UnZip", "6.0"),
    ("Meson", "1.5.2"),
    ("meson-python", "0.16.0"),
    ("Ninja", "1.11.1"),
    ("pkgconf", "1.9.5"),
    ("Cython", "3.0.10"),
    ("pybind11", "2.13.6"),
]
dependencies = [("Python", "3.12.14"), ("Voiage-Python-support", "2.2.0")]
use_pip = True
pip_no_index = True
pip_ignore_installed = True
download_dep_fail = True
sanity_pip_check = True
exts_list = [
    (
        "numpy",
        "2.2.6",
        {
            "ignore_test_result": False,
            "sources": ["numpy-2.2.6.tar.gz"],
            "source_urls": [PYPI_SOURCE],
