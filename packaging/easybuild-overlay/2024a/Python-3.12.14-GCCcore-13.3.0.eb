# Site backport; see NOTICE and source-manifest-python31214.json before reuse.
name = "Python"
version = "3.12.14"

homepage = "https://python.org/"
description = """Python is a programming language that lets you work more quickly and integrate your systems
 more effectively."""

toolchain = {"name": "GCCcore", "version": "13.3.0"}
toolchainopts = {"pic": True}

source_urls = ["https://www.python.org/ftp/%(namelower)s/%(version)s/"]
sources = [SOURCE_TGZ]
patches = ["Python-3.12.3_avoid-tkinter-build.patch"]

# Like patches, but these will only be applied if EasyBuild is configured to filter $LD_LIBRARY_PATH
# In that scenario, ctypes needs to be patched since it heavily relies on $LD_LIBRARY_PATH to find libraries
patch_ctypes_ld_library_path = "Python-3.12.14-custom-ctypes.patch"

checksums = [
    {
        "Python-3.12.14.tgz": "6c6df908d2c3fd24e6d76869e92542abd0f33aec9dfc18df8875f89660286d43"
    },
    {
        "Python-3.12.3_avoid-tkinter-build.patch": "34fa44ca67fc08d41c58db2e289317f12f32777a352a982dca2e63459fc089e3"
    },
    {
        "Python-3.12.14-custom-ctypes.patch": "ef3838753d6bee11fd0f9dea357e65ec419e7aebdb8c87136f92c5826ebf92a1"
    },
]

builddependencies = [
    ("UnZip", "6.0"),
    ("pkgconf", "2.2.0"),
]

dependencies = [
    ("binutils", "2.42"),
    ("bzip2", "1.0.8"),  # required for bz2 package in Python stdlib
    ("zlib", "1.3.1"),
    ("libreadline", "8.2"),
    ("ncurses", "6.5"),
    ("SQLite", "3.45.3"),
    ("XZ", "5.4.5"),
    ("libffi", "3.4.5"),
    ("OpenSSL", "3", "", SYSTEM),
]

exts_default_options = {
    "source_urls": [PYPI_SOURCE],
}

# order is important!
