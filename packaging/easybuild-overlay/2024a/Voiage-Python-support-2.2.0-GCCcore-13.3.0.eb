easyblock = "PythonBundle"
name = "Voiage-Python-support"
version = "2.2.0"
homepage = "https://github.com/edithatogo/voiage"
description = "Pinned Python support providers for the Voiage 2024a candidate."
toolchain = {"name": "GCCcore", "version": "13.3.0"}
builddependencies = [("binutils", "2.42"), ("hatchling", "1.24.2")]
dependencies = [("Python", "3.12.14")]
use_pip = True
pip_no_index = True
pip_ignore_installed = True
download_dep_fail = True
sanity_pip_check = True
