# SPDX-License-Identifier: Apache-2.0
# Authenticated upstream stage0 input; not a source-built compiler output.
easyblock = "Binary"
name = "RustBootstrap"
version = "1.99.0-beta.1"
homepage = "https://www.rust-lang.org/"
description = "Authenticated Linux x86-64 stage0 SDK input for source Rust builds."
toolchain = SYSTEM
sources = ["https://static.rust-lang.org/dist/2026-08-18/rust-beta-x86_64-unknown-linux-gnu.tar.xz"]
checksums = ["f28c53c3142262b9842a4d85d5f3a2eec95cb6a32a0a9401ebb37b9ea4809497"]
extract_sources = True
install_cmd = "bash ./install.sh --prefix=%(installdir)s --components=rustc,cargo,rust-std-x86_64-unknown-linux-gnu --disable-ldconfig"
prepend_to_path = ["bin"]
sanity_check_paths = {"files": ["bin/rustc", "bin/cargo"], "dirs": ["lib/rustlib"]}
sanity_check_commands = ["rustc --version", "cargo --version"]
moduleclass = "tools"
