easyblock = 'CMakeMake'
name = 'xsimd'
version = '14.2.0'
homepage = 'https://arrow.apache.org'
description = 'Source-bound Arrow 25 build provider for the Voiage foss 2024a candidate.'
toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
source_urls = ['https://codeload.github.com/xtensor-stack/xsimd/tar.gz/refs/tags']
sources = [{'download_filename': '14.2.0', 'filename': 'xsimd-14.2.0.tar.gz'}]
checksums = ['21e841ab684b05331e81e7f782431753a029ef7b7d9d6d3ddab837e7782a40ee']
builddependencies = [('binutils', '2.42'), ('CMake', '3.29.3')]
moduleclass = 'lib'
configopts = '-DBUILD_TESTS=OFF -DBUILD_BENCHMARK=OFF -DBUILD_EXAMPLES=OFF -DENABLE_XTL_COMPLEX=OFF'
sanity_check_paths = {'files': ['include/xsimd/xsimd.hpp'], 'dirs': ['share/cmake/xsimd']}
