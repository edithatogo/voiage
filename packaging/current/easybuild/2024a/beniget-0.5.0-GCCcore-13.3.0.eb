# Source candidate. Native build and installed qualification remain separate.
easyblock = "PythonPackage"
name = 'beniget'
version = '0.5.0'
homepage = "https://pypi.org/project/beniget/"
description = "Current Python scientific dependency for the Voiage graph."
toolchain = {"name": "GCCcore", "version": "13.3.0"}
sources = ['https://files.pythonhosted.org/packages/31/a9/cf7c2317da1f5034fdebe84555e14a474b3297ef2d03ad148ff02fef2e3a/beniget-0.5.0.tar.gz']
checksums = ['e7af11fa8ec7de3d3eb3d98b1e722d15d44017d8b35d8aa11d54f6719b312f22']
builddependencies = [('Voiage-Rust-build-support', '2.2.0')]
dependencies = [('Python', '3.15.1'), ('gast', '0.7.0')]
use_pip = True
pip_no_index = True
pip_no_build_isolation = True
download_dep_fail = True
sanity_pip_check = True
moduleclass = "math"
