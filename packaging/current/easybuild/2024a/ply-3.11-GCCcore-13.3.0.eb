# Source candidate. Native build and installed qualification remain separate.
easyblock = "PythonPackage"
name = 'ply'
version = '3.11'
homepage = "https://pypi.org/project/ply/"
description = "Current Python scientific dependency for the Voiage graph."
toolchain = {"name": "GCCcore", "version": "13.3.0"}
sources = ['https://files.pythonhosted.org/packages/e5/69/882ee5c9d017149285cab114ebeab373308ef0f874fcdac9beb90e0ac4da/ply-3.11.tar.gz']
checksums = ['00c7c1aaa88358b9c765b6d3000c6eec0ba42abca5351b095321aef446081da3']
builddependencies = [('Voiage-Rust-build-support', '2.2.0')]
dependencies = [('Python', '3.15.1')]
use_pip = True
pip_no_index = True
pip_no_build_isolation = True
download_dep_fail = True
sanity_pip_check = True
moduleclass = "math"
