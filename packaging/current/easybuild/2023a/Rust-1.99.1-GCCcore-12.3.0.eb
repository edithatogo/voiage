name = "Rust"
version = "1.99.1"
homepage = "https://github.com/edithatogo/voiage"
description = "Source-bound foss 2023a provider for the Voiage HPC candidate."
toolchain = {"name": "GCCcore", "version": "12.3.0"}

source_urls = ["https://static.rust-lang.org/dist/"]
sources = ["rustc-1.99.1-src.tar.xz"]
patches = ["Rust-1.96_sysroot-fix-interpreter.patch"]
checksums = [
    "6451598a99e77f07571960f6b21d577399d3a30f33e80cbd2e3a4aae6535d265",
    "beb558ea39683772ff3b06e189e178604a3fa835f6a0f66be0e14d9cdb5512f1",
]
builddependencies = [
    ("RustBootstrap", "1.98.0", "", SYSTEM),
    ("binutils", "2.40"),
    ("CMake", "3.26.3"),
    ("Python", "3.15.1"),
    ("Ninja", "1.11.1"),
    ("pkgconf", "1.9.5"),
    ("patchelf", "0.18.0"),
]
dependencies = [("OpenSSL", "3", "", SYSTEM)]
channel = "stable"
configopts = "--set=rust.download-rustc=false --set=build.vendor=true --set=llvm.link-jobs=1 --set=build.rustc=$EBROOTRUSTBOOTSTRAP/bin/rustc --set=build.cargo=$EBROOTRUSTBOOTSTRAP/bin/cargo"
moduleclass = "lang"
