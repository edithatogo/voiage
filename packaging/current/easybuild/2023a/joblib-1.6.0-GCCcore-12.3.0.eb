# Source candidate. Native build and installed qualification remain separate.
easyblock = "PythonPackage"
name = 'joblib'
version = '1.6.0'
homepage = "https://pypi.org/project/joblib/"
description = "Current Python scientific dependency for the Voiage graph."
toolchain = {"name": "GCCcore", "version": "12.3.0"}
sources = ['https://files.pythonhosted.org/packages/d5/1d/537ab090f302b838943a1b56497dd53059b9a9b46a074936470173a2e207/joblib-1.6.0.tar.gz']
checksums = ['2ccc96785b12046c08fd6d55839c12857831b54a3c1673ffadd2f04bfc4eda03']
builddependencies = [('cloudpickle', '3.1.2'), ('cloudpickle', '3.1.2'), ('cloudpickle', '3.1.2'), ('Voiage-Rust-build-support', '2.2.0')]
dependencies = [('Python', '3.15.1')]
use_pip = True
pip_no_index = True
pip_no_build_isolation = True
download_dep_fail = True
sanity_pip_check = True
moduleclass = "math"
