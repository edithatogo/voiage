# Source candidate. Native build and installed qualification remain separate.
easyblock = "PythonPackage"
name = 'SciPy'
version = '1.18.1'
homepage = "https://pypi.org/project/scipy/"
description = "Current Python scientific dependency for the Voiage graph."
toolchain = {"name": "gfbf", "version": "2023a"}
sources = ['https://files.pythonhosted.org/packages/7e/74/66de6258867beb2ef08f35f9f2ac017a52cacd5081714d239ff1a442d458/scipy-1.18.1.tar.gz']
