builddependencies = [('Cython', '3.3.1'), ('meson-python', '0.22.1'), ('pythran', '0.19.0'), ('Voiage-Rust-build-support', '2.2.0')]
dependencies = [('Python', '3.15.1'), ('NumPy', '2.5.4')]
use_pip = True
pip_no_index = True
pip_no_build_isolation = True
download_dep_fail = True
sanity_pip_check = True
