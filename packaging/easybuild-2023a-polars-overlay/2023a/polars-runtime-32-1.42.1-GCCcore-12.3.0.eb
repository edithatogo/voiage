dependencies = [('Python', '3.12.14')]
preinstallopts = 'export RUSTC="$EBROOTRUSTMINNIGHTLY/bin/rustc" CARGO="$EBROOTRUSTMINNIGHTLY/bin/cargo" && '
offline = True
use_pip = True
pip_no_index = True
pip_no_build_isolation = True
pip_ignore_installed = True
download_dep_fail = True
sanity_pip_check = True
sanity_check_paths = {'files': [], 'dirs': ['lib/python3.12/site-packages/_polars_runtime_32']}
sanity_check_commands = [
    "python -c \"import _polars_runtime_32; from pathlib import Path; assert any(Path(_polars_runtime_32.__path__[0]).glob('_polars_runtime*.so'))\"",
]
moduleclass = 'data'
