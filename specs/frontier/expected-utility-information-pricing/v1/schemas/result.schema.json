{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/frontier/expected-utility-information-pricing/v1/result.schema.json",
  "title": "Expected utility information pricing result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method", "method_maturity", "input_digest", "provenance", "decision_descriptor", "backend", "reporting_metadata", "information_kind", "payoff_unit", "utility", "current_expected_utility", "informed_expected_utility", "current_certainty_equivalent", "informed_certainty_equivalent", "current_policy", "informed_policies", "eui", "cei", "bpi", "spi", "ppi", "bpi_root", "spi_root", "affine_reduction", "comparability", "presentation"],
  "properties": {
    "schema_version": {"const": "expected-utility-information-result-v1"},
    "method": {"const": "expected_utility_information"},
    "method_maturity": {"const": "experimental"},
    "input_digest": {"$ref": "#/$defs/input_digest"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "decision_descriptor": {"$ref": "#/$defs/decision_descriptor"},
    "backend": {"$ref": "#/$defs/backend"},
    "reporting_metadata": {"$ref": "#/$defs/reporting_metadata"},
    "information_kind": {"enum": ["clairvoyant", "finite_signal"]},
    "payoff_unit": {"type": "string", "minLength": 1},
    "utility": {"$ref": "request.schema.json#/$defs/utility"},
    "current_expected_utility": {"type": "number"},
    "informed_expected_utility": {"type": "number"},
    "current_certainty_equivalent": {"type": "number"},
    "informed_certainty_equivalent": {"type": "number"},
    "current_policy": {"$ref": "#/$defs/policy"},
    "informed_policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
    "eui": {"$ref": "#/$defs/measure"}, "cei": {"$ref": "#/$defs/measure"},
    "bpi": {"$ref": "#/$defs/measure"}, "spi": {"$ref": "#/$defs/measure"}, "ppi": {"$ref": "#/$defs/measure"},
    "bpi_root": {"$ref": "#/$defs/root"}, "spi_root": {"$ref": "#/$defs/root"},
    "affine_reduction": {"$ref": "#/$defs/affine_reduction"},
    "comparability": {"$ref": "#/$defs/comparability"},
    "presentation": {"$ref": "#/$defs/presentation"}
  },
  "$defs": {
    "measure": {
      "type": "object", "additionalProperties": false,
      "required": ["measure", "status", "value", "unit", "direction", "normalization", "diagnostics_ref"],
      "properties": {
        "measure": {"enum": ["eui", "cei", "bpi", "spi", "ppi"]},
        "status": {"enum": ["available", "unavailable", "failed"]},
        "value": {"type": ["number", "null"]}, "unit": {"type": "string"}, "direction": {"type": "string"},
        "normalization": {"type": "string", "minLength": 1}, "diagnostics_ref": {"type": ["string", "null"]}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["signal_id", "tie_set", "representative_action_id", "domain_exclusions"],
      "properties": {"signal_id": {"type": ["string", "null"]}, "tie_set": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "representative_action_id": {"type": ["string", "null"]}, "domain_exclusions": {"type": "array", "items": {"$ref": "#/$defs/domain_exclusion"}}}
    },
    "policy_evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["transfer", "objective_value", "policies"],
      "properties": {"transfer": {"type": "number"}, "objective_value": {"type": "number"}, "policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policy"}}}
    },
    "domain_exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["signal_id", "action_id", "state_ids", "reason"],
      "properties": {"signal_id": {"type": ["string", "null"]}, "action_id": {"type": "string", "minLength": 1}, "state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reason": {"const": "utility_domain"}}
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transfer", "prior_policies", "next_policies"],
      "properties": {"transfer": {"type": "number"}, "prior_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policy"}}, "next_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policy"}}}
    },
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "estimate", "lower", "upper", "final_bracket_width", "residual", "iterations", "evaluations", "lower_policies", "upper_policies", "evaluated_policies", "policy_switched", "transitions", "termination_reason", "solver"],
      "properties": {
        "status": {"enum": ["converged", "zero_boundary", "not_bracketed", "utility_domain", "non_monotone", "discontinuous_no_root", "max_iterations", "max_evaluations"]},
        "estimate": {"type": ["number", "null"]}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}, "final_bracket_width": {"type": ["number", "null"]}, "residual": {"type": ["number", "null"]},
        "iterations": {"type": "integer", "minimum": 0}, "evaluations": {"type": "integer", "minimum": 0},
        "lower_policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}}, "upper_policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
        "evaluated_policies": {"type": "array", "items": {"$ref": "#/$defs/policy_evaluation"}},
        "policy_switched": {"type": "boolean"}, "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "termination_reason": {"type": "string", "minLength": 1}, "solver": {"$ref": "request.schema.json#/$defs/solver"}
      }
    },
    "affine_reduction": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "monetary_measure", "value"],
      "properties": {"status": {"enum": ["available", "unavailable"]}, "monetary_measure": {"type": ["string", "null"], "enum": ["evpi", "evsi", null]}, "value": {"type": ["number", "null"]}}
    },
    "comparability": {
      "type": "object", "additionalProperties": false,
      "required": ["stakeholder_scope_id", "numeric_within_problem", "numeric_cross_problem", "required_shared_fields", "ranking_equivalence"],
      "properties": {"stakeholder_scope_id": {"type": "string"}, "numeric_within_problem": {"type": "boolean"}, "numeric_cross_problem": {"type": "boolean"}, "required_shared_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "ranking_equivalence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ranking_equivalence"}}}
    },
    "ranking_equivalence": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "left_measure", "right_measure", "status", "condition"],
      "properties": {"scope": {"enum": ["within_problem", "cross_problem"]}, "left_measure": {"enum": ["eui", "cei", "bpi", "spi", "ppi"]}, "right_measure": {"enum": ["eui", "cei", "bpi", "spi", "ppi"]}, "status": {"enum": ["equivalent", "conditional", "not_assured"]}, "condition": {"type": "string", "minLength": 1}}
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["presentation_label", "selected_measure", "canonical_result_ref"],
      "properties": {"presentation_label": {"enum": ["canonical", "voc"]}, "selected_measure": {"enum": ["eui", "cei", "bpi", "spi", "ppi", "evpi"]}, "canonical_result_ref": {"const": "self"}}
    },
    "input_digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {"algorithm": {"const": "rfc8785-sha256-v1"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "source_dirty", "source_tree_git_oid", "source_state_sha256", "build_id"],
      "properties": {"source_revision": {"type": "string", "minLength": 1}, "source_dirty": {"type": "boolean"}, "source_tree_git_oid": {"type": "string", "minLength": 1}, "source_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "build_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "decision_descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_problem_id", "stakeholder_scope_id", "action_ids", "state_ids", "initial_wealth", "payoff_unit", "currency", "price_date", "information_cost_location"],
      "properties": {"decision_problem_id": {"type": "string", "minLength": 1}, "stakeholder_scope_id": {"type": "string", "minLength": 1}, "action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "initial_wealth": {"type": "number"}, "payoff_unit": {"type": "string", "minLength": 1}, "currency": {"type": ["string", "null"]}, "price_date": {"type": ["string", "null"]}, "information_cost_location": {"const": "ex_ante_sure_transfer"}}
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "bridge", "crate", "version"],
      "properties": {"engine": {"const": "rust"}, "bridge": {"const": "pyo3"}, "crate": {"const": "voiage-python"}, "version": {"type": "string", "minLength": 1}}
    },
    "reporting_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["deterministic", "canonical_ordering", "presentation_label"],
      "properties": {"deterministic": {"const": true}, "canonical_ordering": {"const": "rfc8785"}, "presentation_label": {"enum": ["canonical", "voc"]}}
    }
  }
}
