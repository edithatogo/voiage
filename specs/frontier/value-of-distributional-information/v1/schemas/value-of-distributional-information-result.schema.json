{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/frontier/value-of-distributional-information-result.v1.json",
  "title": "ValueOfDistributionalInformationResultV1Experimental",
  "type": "object",
  "required": ["schema_version", "analysis_id", "analysis_type", "method_maturity", "information_target", "conditioning_order", "direction", "value_unit", "model_ids", "model_labels", "model_probabilities", "alternative_names", "conditional_values", "current_expected_values", "current_value", "current_optimal_alternatives", "current_representative", "resolved_models", "expected_resolved_value", "gross_vdi", "information_cost", "net_vdi", "estimator", "comparability", "provenance", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_id": {"type": "string", "minLength": 1},
    "analysis_type": {"const": "distribution_family_information_value"},
    "method_maturity": {"const": "experimental"},
    "information_target": {"const": "model_family_index"},
    "conditioning_order": {"const": "integrate_within_family_then_resolve_family_index"},
    "direction": {"enum": ["maximize", "minimize"]},
    "value_unit": {"type": "string", "minLength": 1},
    "model_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "model_labels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "model_probabilities": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "alternative_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conditional_values": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}},
    "current_expected_values": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "current_value": {"type": "number"},
    "current_optimal_alternatives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "current_representative": {"type": "string", "minLength": 1},
    "resolved_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_id", "model_label", "probability", "conditional_values", "optimal_alternatives", "representative", "resolved_value", "weighted_contribution"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "model_label": {"type": "string", "minLength": 1},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "conditional_values": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "optimal_alternatives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "representative": {"type": "string", "minLength": 1},
          "resolved_value": {"type": "number"},
          "weighted_contribution": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "expected_resolved_value": {"type": "number"},
    "gross_vdi": {"type": "number", "minimum": 0},
    "information_cost": {"type": "number", "minimum": 0},
    "net_vdi": {"type": "number"},
    "estimator": {
      "type": "object",
      "required": ["status", "uncertainty_status", "absolute_tolerance", "relative_tolerance"],
      "properties": {
        "status": {"const": "exact_enumeration"},
        "uncertainty_status": {"const": "exact"},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "comparability": {"$ref": "#/$defs/comparability"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "diagnostics": {
      "type": "object",
      "required": ["tie_policy", "probability_sum", "nonnegativity_residual", "conditioning_verified", "structural_evpi_relation"],
      "properties": {
        "tie_policy": {"const": "complete-set-canonical-lexicographic-representative"},
        "probability_sum": {"type": "number"},
        "nonnegativity_residual": {"type": "number"},
        "conditioning_verified": {"const": true},
        "structural_evpi_relation": {"const": "not_computed_model_family_only_is_bounded_by_matched_full_information"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "comparability": {
      "type": "object",
      "required": ["population", "horizon", "discounting", "value_semantics", "cost_location"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "discounting": {"type": "string", "minLength": 1},
        "value_semantics": {"type": "string", "minLength": 1},
        "cost_location": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["fixture_id", "probability_source", "value_source", "family_definition_source"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "probability_source": {"type": "string", "minLength": 1},
        "value_source": {"type": "string", "minLength": 1},
        "family_definition_source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
