{
  "$defs": {
    "blackwell": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "checked_value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "passed": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons_not_applicable": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "applicable",
        "checked_value",
        "passed",
        "reasons_not_applicable"
      ],
      "type": "object"
    },
