    "assurance": {
      "additionalProperties": false,
      "properties": {
        "complete_joint_world_law": {
          "const": true
        },
        "designs_evaluated": {
          "minimum": 2,
          "type": "integer"
        },
        "deterministic_serialization": {
          "const": true
        },
        "finite_catalog_only": {
          "const": true
        },
        "general_game_solver_used": {
          "const": false
