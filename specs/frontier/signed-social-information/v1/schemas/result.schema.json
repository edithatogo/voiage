        },
        "post_transfer": {
          "$ref": "#/$defs/number_map"
        },
        "pre_transfer": {
          "$ref": "#/$defs/number_map"
        },
        "transfer": {
          "$ref": "#/$defs/number_map"
        }
      },
      "required": [
        "pre_transfer",
        "transfer",
        "cost",
        "post_transfer"
