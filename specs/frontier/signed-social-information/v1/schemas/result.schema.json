        "policies_evaluated": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "policy_selector_values": {
          "$ref": "#/$defs/number_map"
        },
        "policy_switch": {
          "type": "boolean"
        },
        "policy_tie": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "recipients": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "rights_receipts": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "selected_policy_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "selection_mode": {
          "enum": [
            "centralized",
            "fixed",
            "declared_response",
            "verified_finite_equilibrium"
          ]
