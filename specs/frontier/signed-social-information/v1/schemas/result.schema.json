    "number_map": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "signed_values": {
      "additionalProperties": false,
      "properties": {
        "by_agent": {
          "$ref": "#/$defs/number_map"
        },
        "by_role": {
          "$ref": "#/$defs/number_map"
        },
        "clipped_at_zero": {
          "const": false
