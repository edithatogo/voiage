          "$ref": "#/$defs/blackwell"
        },
        "comparator_design_id": {
          "oneOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "design_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "type": "string"
        },
