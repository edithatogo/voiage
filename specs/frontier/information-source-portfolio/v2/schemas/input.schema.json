{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/frontier/information-source-portfolio-input.v2.json",
  "title": "InformationSourcePortfolioInputV2Experimental",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_type",
    "method_maturity",
    "value_context",
    "actions",
    "states",
    "sources",
    "constraints",
    "tie_policy",
    "provenance",
    "shared_costs"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "analysis_type": {
      "const": "information_source_portfolio"
    },
    "method_maturity": {
      "const": "experimental"
    },
    "value_context": {
      "type": "object",
      "required": [
        "value_unit",
        "cost_unit",
        "time_unit",
        "population_basis",
        "horizon_basis",
        "discount_basis",
        "delay_cost_per_time"
      ],
      "properties": {
        "value_unit": {
          "type": "string",
          "minLength": 1
        },
        "cost_unit": {
          "type": "string",
          "minLength": 1
        },
        "time_unit": {
          "type": "string",
          "minLength": 1
        },
        "population_basis": {
          "type": "string",
          "minLength": 1
        },
        "horizon_basis": {
          "type": "string",
          "minLength": 1
        },
        "discount_basis": {
          "type": "string",
          "minLength": 1
        },
        "delay_cost_per_time": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "probability",
          "action_values",
          "source_observations"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "probability": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "action_values": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "type": "number"
            }
          },
          "source_observations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "label",
          "cost",
          "cost_unit",
          "latency",
          "privacy_cost",
          "freshness_age",
          "sla_probability",
          "coverage",
          "excludes",
          "must_precede",
          "rights",
          "asset_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "cost_unit": {
            "type": "string",
            "minLength": 1
          },
          "latency": {
            "type": "number",
            "minimum": 0
          },
          "privacy_cost": {
            "type": "number",
            "minimum": 0
          },
          "freshness_age": {
            "type": "number",
            "minimum": 0
          },
          "sla_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "coverage": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "excludes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "must_precede": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "rights": {
            "type": "object",
            "required": [
              "status",
              "license_id",
              "basis",
              "source_uri",
              "content_sha256"
            ],
            "properties": {
              "status": {
                "const": "cleared"
              },
              "license_id": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "source_uri": {
                "type": "string",
                "format": "uri",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "asset_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "max_cost",
        "max_latency",
        "max_privacy_cost",
        "max_sources",
        "min_source_sla",
        "max_freshness_age",
        "required_coverage"
      ],
      "properties": {
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_latency": {
          "type": "number",
          "minimum": 0
        },
        "max_privacy_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "min_source_sla": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_freshness_age": {
          "type": "number",
          "minimum": 0
        },
        "required_coverage": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "tie_policy": {
      "type": "object",
      "required": [
        "absolute_tolerance",
        "relative_tolerance",
        "sequence_selection"
      ],
      "properties": {
        "absolute_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "relative_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "sequence_selection": {
          "const": "highest_net_then_lower_cost_latency_lexical"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "decision_revision",
        "joint_world_source",
        "constraint_source",
        "evaluator",
        "software_version"
      ],
      "properties": {
        "decision_revision": {
          "type": "string",
          "minLength": 1
        },
        "joint_world_source": {
          "type": "string",
          "minLength": 1
        },
        "constraint_source": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "software_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "shared_costs": {
      "type": "object",
      "required": [
        "assets",
        "existing_assets"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "cost",
              "cost_unit"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
              },
              "cost": {
                "type": "number",
                "minimum": 0
              },
              "cost_unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "existing_assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
