{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/frontier/implementation-information-input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "analysis_type", "value_unit",
    "population", "discounted_time_factor", "chronology", "actions", "states",
    "current_implementation", "costs"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "analysis_id": {"type": "string", "minLength": 1},
    "analysis_type": {"const": "implementation_information_decomposition"},
    "value_unit": {"type": "string", "minLength": 1},
    "population": {"type": "number", "exclusiveMinimum": 0},
    "discounted_time_factor": {"type": "number", "exclusiveMinimum": 0},
    "chronology": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "tie_tolerance": {"type": "number", "minimum": 0},
    "actions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "states": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "current_implementation": {"type": "object"},
    "specific_implementation": {"type": "object"},
    "sampling_model": {"type": "object"},
    "costs": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
  }
}
