{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/frontier/implementation-information-input.v1.json",
  "$defs": {
    "identifier": {"type": "string", "minLength": 1},
    "probabilityVector": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "scenario": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 2,
        "additionalProperties": {"$ref": "#/$defs/probabilityVector"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "probability", "net_benefit"],
      "properties": {
        "state_id": {"$ref": "#/$defs/identifier"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "net_benefit": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "likelihood_by_state"],
      "properties": {
        "signal_id": {"$ref": "#/$defs/identifier"},
        "likelihood_by_state": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "analysis_type", "value_unit",
    "population", "discounted_time_factor", "chronology", "actions", "states",
    "current_implementation", "costs"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "analysis_id": {"$ref": "#/$defs/identifier"},
    "analysis_type": {"const": "implementation_information_decomposition"},
    "value_unit": {"$ref": "#/$defs/identifier"},
    "population": {"type": "number", "exclusiveMinimum": 0},
    "discounted_time_factor": {"type": "number", "exclusiveMinimum": 0},
    "chronology": {
      "type": "array", "minItems": 3,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "tie_tolerance": {"type": "number", "minimum": 0},
    "actions": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}},
    "current_implementation": {"$ref": "#/$defs/scenario"},
    "specific_implementation": {"$ref": "#/$defs/scenario"},
    "sampling_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals", "post_sample_implementation"],
      "properties": {
        "signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signal"}},
        "post_sample_implementation": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/scenario"}
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perfect_information": {"type": "number", "minimum": 0},
        "perfect_implementation": {"type": "number", "minimum": 0},
        "specific_implementation": {"type": "number", "minimum": 0},
        "sample": {"type": "number", "minimum": 0}
      }
    }
  }
}
