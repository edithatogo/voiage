{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/frontier/implementation-information-result.v1.json",
  "$defs": {
    "numberMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
    "tieMap": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "stateActionValues": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/numberMap"}
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["per_person_time_value", "aggregate_value", "policy_ties", "state_action_values"],
      "properties": {
        "per_person_time_value": {"type": "number"},
        "aggregate_value": {"type": "number"},
        "policy_ties": {"$ref": "#/$defs/tieMap"},
        "state_action_values": {"$ref": "#/$defs/stateActionValues"}
      }
    },
    "sampleCell": {
      "type": "object", "additionalProperties": false,
      "required": ["per_person_time_value", "aggregate_value", "policy_ties", "signal_action_joint_values"],
      "properties": {
        "per_person_time_value": {"type": "number"},
        "aggregate_value": {"type": "number"},
        "policy_ties": {"$ref": "#/$defs/tieMap"},
        "signal_action_joint_values": {"$ref": "#/$defs/stateActionValues"}
      }
    },
    "scenario": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "minProperties": 2,
        "additionalProperties": {"$ref": "#/$defs/numberMap"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "analysis_type", "method_maturity",
    "value_unit", "population", "discounted_time_factor", "chronology", "matrix",
    "implementation_audit", "uptake_changes", "gross_components", "net_components",
    "identity_residuals", "decision_switches", "terminology", "assurance"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "analysis_id": {"type": "string", "minLength": 1},
    "analysis_type": {"const": "implementation_information_decomposition"},
    "method_maturity": {"const": "experimental"},
    "value_unit": {"type": "string", "minLength": 1},
    "population": {"type": "number", "exclusiveMinimum": 0},
    "discounted_time_factor": {"type": "number", "exclusiveMinimum": 0},
    "chronology": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": [
        "current_information_current_implementation",
        "perfect_information_current_implementation",
        "current_information_perfect_implementation",
        "perfect_information_perfect_implementation"
      ],
      "properties": {
        "current_information_current_implementation": {"$ref": "#/$defs/cell"},
        "perfect_information_current_implementation": {"$ref": "#/$defs/cell"},
        "current_information_perfect_implementation": {"$ref": "#/$defs/cell"},
        "perfect_information_perfect_implementation": {"$ref": "#/$defs/cell"},
        "current_information_specific_implementation": {"$ref": "#/$defs/cell"},
        "perfect_information_specific_implementation": {"$ref": "#/$defs/cell"},
        "sample_information_post_sample_implementation": {"$ref": "#/$defs/sampleCell"}
      }
    },
    "implementation_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["current", "perfect"],
      "properties": {
        "current": {"$ref": "#/$defs/scenario"},
        "perfect": {"$ref": "#/$defs/scenario"},
        "specific": {"$ref": "#/$defs/scenario"},
        "post_sample_by_signal": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/scenario"}
        }
      }
    },
    "uptake_changes": {
      "type": "object", "additionalProperties": false,
      "required": ["perfect_minus_current"],
      "properties": {
        "perfect_minus_current": {"$ref": "#/$defs/scenario"},
        "specific_minus_current": {"$ref": "#/$defs/scenario"},
        "post_sample_minus_current_by_signal": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/scenario"}
        }
      }
    },
    "gross_components": {
      "type": "object", "additionalProperties": false,
      "required": ["realizable_evpi", "evpim", "evp", "evpi_under_perfect_implementation", "interaction"],
      "properties": {
        "realizable_evpi": {"type": "number"}, "evpim": {"type": "number"},
        "evp": {"type": "number"}, "evpi_under_perfect_implementation": {"type": "number"},
        "interaction": {"type": "number"}, "evsim": {"type": "number"},
        "ia_evsi": {"type": "number"}
      }
    },
    "net_components": {"$ref": "#/$defs/numberMap"},
    "identity_residuals": {
      "type": "object", "additionalProperties": false,
      "required": ["evp_equals_realizable_evpi_plus_evpim_plus_interaction", "perfect_implementation_evpi_equals_evp_minus_evpim"],
      "properties": {
        "evp_equals_realizable_evpi_plus_evpim_plus_interaction": {"type": "number"},
        "perfect_implementation_evpi_equals_evp_minus_evpim": {"type": "number"}
      }
    },
    "decision_switches": {
      "type": "object", "additionalProperties": false,
      "required": ["current_to_perfect_information", "current_to_perfect_implementation", "current_to_specific_implementation", "sample_information"],
      "properties": {
        "current_to_perfect_information": {"type": "boolean"},
        "current_to_perfect_implementation": {"type": "boolean"},
        "current_to_specific_implementation": {"type": ["boolean", "null"]},
        "sample_information": {"oneOf": [{"$ref": "#/$defs/tieMap"}, {"type": "null"}]}
      }
    },
    "terminology": {
      "type": "object", "additionalProperties": false,
      "required": ["EVEIm", "EVSEIm", "status"],
      "properties": {"EVEIm": {"type": "string"}, "EVSEIm": {"type": "string"}, "status": {"type": "string"}}
    },
    "assurance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "estimator", "tie_policy", "tie_tolerance",
        "implementation_information_independence_assumed",
        "state_dependent_current_implementation_observed",
        "signal_dependent_post_sample_implementation_supported",
        "language_dispositions"
      ],
      "properties": {
        "estimator": {"const": "exact_finite_enumeration"},
        "tie_policy": {"const": "complete_ties_sorted_by_action_id"},
        "tie_tolerance": {"type": "number", "minimum": 0},
        "implementation_information_independence_assumed": {"const": false},
        "state_dependent_current_implementation_observed": {"type": "boolean"},
        "signal_dependent_post_sample_implementation_supported": {"type": "boolean"},
        "language_dispositions": {
          "type": "object", "additionalProperties": false,
          "required": ["Python", "Rust", "R", "Julia", "Mojo"],
          "properties": {
            "Python": {"const": "experimental_runtime"},
            "Rust": {"const": "not_implemented"}, "R": {"const": "not_implemented"},
            "Julia": {"const": "not_implemented"}, "Mojo": {"const": "not_implemented"}
          }
        }
      }
    }
  }
}
