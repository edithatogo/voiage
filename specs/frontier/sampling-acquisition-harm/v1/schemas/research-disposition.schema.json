{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/frontier/sampling-acquisition-harm/v1/schemas/research-disposition.schema.json",
  "title": "SamplingAcquisitionHarmResearchDispositionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition_id",
    "capability_id",
    "scope_selection_ref",
    "disposition",
    "candidate_scope",
    "runtime_prohibited",
    "approved_runtime_symbols",
    "permitted_claims",
    "prohibited_claims",
    "adjacent_methods",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "disposition_id": {"const": "sampling-acquisition-harm-research-v1"},
    "capability_id": {"const": "sampling-acquisition-harm-v1"},
    "scope_selection_ref": {"const": "scope-selection.json"},
    "disposition": {"const": "unsupported_research_scoping"},
    "candidate_scope": {"const": "research_contract_only"},
    "runtime_prohibited": {"const": true},
    "approved_runtime_symbols": {"type": "array", "maxItems": 0},
    "permitted_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibited_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adjacent_methods": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/adjacent_method"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "adjacent_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "method", "relationship", "execution_reuse_allowed", "reason"],
      "properties": {
        "issue": {"enum": [570, 595]},
        "method": {"type": "string", "minLength": 1},
        "relationship": {"const": "not_sampling_acquisition_harm"},
        "execution_reuse_allowed": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "authority", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {"enum": ["pending", "blocked", "external_pending"]},
        "authority": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
