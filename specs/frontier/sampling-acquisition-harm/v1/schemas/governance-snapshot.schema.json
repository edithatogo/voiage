    "issue853": {"allOf": [{"$ref": "#/$defs/issueBase"}, {"properties": {"number": {"const": 853}, "node_id": {"const": "I_kwDOPF8PXM8AAAABLJXLWw"}, "project_item_id": {"const": "PVTI_lAHOAOYc4M4Bd0Txzg0-m44"}, "project_item_updated_at": {"const": "2026-08-02T18:22:45Z"}, "url": {"const": "https://github.com/edithatogo/voiage/issues/853"}, "project_fields_sha256": {"const": "44b5a7df94668f0fbe48e2e8102545f1a0e74083535ecfc0e8693821cd0e1943"}}}]},
    "projectFields": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "evidence_state", "gate", "lifecycle", "moscow", "owner_role", "priority", "record_id", "record_type", "repository", "review_due", "risk_level", "status", "sync_state", "track_id"],
      "properties": {
        "contract_version": {"const": "1.3.0"}, "evidence_state": {"const": "Unverified"},
        "gate": {"const": "Human"}, "lifecycle": {"const": "Mitigating"}, "moscow": {"const": "Must"},
        "owner_role": {"enum": ["Risk and sampling domain reviewer", "Independent scientific/domain adjudicator"]},
        "priority": {"const": "P1"}, "record_id": {"enum": ["SAMPLING-HARM-850", "SAMPLING-HARM-853"]},
        "record_type": {"const": "Current track"}, "repository": {"const": "https://github.com/edithatogo/voiage"},
        "review_due": {"const": "2026-11-30"},
        "risk_level": {"const": "Critical"}, "status": {"const": "In Progress"},
        "sync_state": {"const": "Clean"}, "track_id": {"const": "sampling_acquisition_harm_voi_20260802"}
      }
