    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["preparation_only", "scientific_review_completed", "human_confirmation_received", "maintainer_disposition_recorded", "runtime_authorized", "real_study_authorized"],
      "properties": {
        "preparation_only": {"const": true}, "scientific_review_completed": {"const": false},
        "human_confirmation_received": {"const": false}, "maintainer_disposition_recorded": {"const": false},
        "runtime_authorized": {"const": false}, "real_study_authorized": {"const": false}
      }
