        "merge_commit": {"const": "2367074d4b8ea14590746286649d9afb8ebebaef"},
        "successful_checks": {"const": 32}, "governed_skips": {"const": 3},
        "neutral_checks": {"const": 1}, "failed_or_pending_checks": {"const": 0},
        "unresolved_review_threads": {"const": 0}
      }
