{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/frontier/sampling-acquisition-harm/v1/schemas/scope-selection.schema.json",
  "title": "SamplingAcquisitionHarmScopeSelectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_id",
    "track_id",
    "planned_version",
    "issue_refs",
    "reviewed_source_commit",
    "reviewed_source_tree",
    "selected_at",
    "selected_review_path",
    "proposed_disposition",
    "selection_status",
    "scientific_disposition",
    "review_target",
    "rationale",
    "alternatives_considered",
    "evidence_refs",
    "runtime_disposition",
    "review_completed",
    "human_confirmation_received",
    "real_study_authorized",
    "approved_runtime_symbols",
    "next_tasks",
    "reconsideration_entry_requirements",
    "downstream_review_gates",
    "not_authorized"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "selection_id": {"const": "sampling-acquisition-harm-h8a-20260803"},
    "track_id": {"const": "sampling_acquisition_harm_voi_20260802"},
    "planned_version": {"const": "1.3.0"},
    "issue_refs": {
      "type": "array",
      "prefixItems": [
        {"const": "https://github.com/edithatogo/voiage/issues/850"},
        {"const": "https://github.com/edithatogo/voiage/issues/853"}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "reviewed_source_commit": {"$ref": "#/$defs/git_oid"},
    "reviewed_source_tree": {"$ref": "#/$defs/git_oid"},
    "selected_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "selected_review_path": {"const": "generic_kernel_exclusion_review"},
    "proposed_disposition": {"const": "reviewed_exclusion"},
    "selection_status": {"const": "selected_for_candidate_bound_review"},
    "scientific_disposition": {"const": "pending"},
    "review_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "domain", "jurisdiction", "population", "sampling_activity", "comparator", "affected_parties", "harm_categories", "excluded_semantics"],
      "properties": {
        "capability": {"const": "generic_automatic_scalar_or_authorizing_sampling_acquisition_harm_kernel"},
        "domain": {"const": "unspecified"},
        "jurisdiction": {"const": "unspecified"},
        "population": {"const": "unspecified"},
        "sampling_activity": {"const": "unspecified"},
        "comparator": {"const": "unspecified"},
        "affected_parties": {"const": "unspecified"},
        "harm_categories": {"const": "unspecified"},
        "excluded_semantics": {"const": "automatic_scalar_aggregation_or_study_authorization"}
      }
    },
    "rationale": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "alternatives_considered": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["not_reviewable", "future_candidate_class"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_refs": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/evidence_ref"}},
    "runtime_disposition": {"const": "unsupported_research_scoping"},
    "review_completed": {"const": false},
    "human_confirmation_received": {"const": false},
    "real_study_authorized": {"const": false},
    "approved_runtime_symbols": {"type": "array", "maxItems": 0},
    "next_tasks": {
      "type": "array",
      "prefixItems": [
        {"const": "H8-C"},
        {"const": "H8-D"},
        {"const": "H8-E"},
        {"const": "H8-F"},
        {"const": "H8-G"},
        {"const": "H8-H"}
      ],
      "minItems": 6,
      "maxItems": 6
    },
    "reconsideration_entry_requirements": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "narrow_domain_candidate",
          "applicable_jurisdiction_authority",
          "defined_population_and_affected_parties",
          "defined_sampling_action_and_comparator",
          "identified_harm_law_and_data",
          "defined_reporting_and_dropout_model",
          "declared_risk_ordering_and_component_ledger",
          "estimator_assurance_plan"
        ]
      }
    },
    "downstream_review_gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "candidate_bound_independent_review",
          "two_named_human_confirmations",
          "estimator_assurance",
          "maintainer_implementation_decision"
        ]
      }
    },
    "not_authorized": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "completed_reviewed_exclusion",
          "scientific_acceptance",
          "maintainer_disposition",
          "runtime_implementation",
          "polyglot_parity",
          "stable_promotion",
          "real_study_activity",
          "ethics_regulatory_authorization",
          "release",
          "publication",
          "registry_acceptance",
          "issue_closure"
        ]
      }
    }
  },
  "$defs": {
    "git_oid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha1"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
