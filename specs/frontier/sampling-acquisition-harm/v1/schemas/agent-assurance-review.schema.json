{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/sampling-acquisition-harm/agent-assurance-review-v1.0.0.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "assurance_mode", "owner_decision", "candidate_binding", "panel_reports", "synthesis", "source_receipts", "findings", "panel_roles", "protocol", "source_assessment", "provisional_conclusion", "prohibited_claims", "authority", "expiry"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_kind": {"const": "agent_only_assurance_review_not_human_review"}, "assurance_mode": {"const": "agent_only"}, "observed_at": {"type": "string", "format": "date-time"},
    "owner_decision": {"type": "object", "additionalProperties": false, "required": ["status", "decision", "rationale", "residual_risk"], "properties": {"status": {"const": "accepted_limitation"}, "decision": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "residual_risk": {"type": "string", "minLength": 1}}},
    "candidate_binding": {"type": "object", "required": ["candidate_commit", "candidate_tree", "packet_sha256"], "properties": {"candidate_commit": {"type": "string"}, "candidate_tree": {"type": "string"}, "packet_sha256": {"type": "string"}}}, "panel_reports": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["role", "path", "sha256", "actor_type", "authorizing"], "properties": {"role": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string"}, "actor_type": {"const": "agent"}, "authorizing": {"const": false}}}}, "synthesis": {"type": "object", "required": ["path", "sha256", "actor_type", "preserves_dissent", "authorizing"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "actor_type": {"const": "agent"}, "preserves_dissent": {"const": true}, "authorizing": {"const": false}}}, "source_receipts": {"type": "object", "required": ["path", "sha256", "receipt_mode", "retained_source_bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "receipt_mode": {"const": "agent_observed_only"}, "retained_source_bytes": {"const": false}}}, "findings": {"type": "object", "required": ["register_path", "register_sha256", "count", "all_disposition_status"], "properties": {"register_path": {"type": "string"}, "register_sha256": {"type": "string"}, "count": {"const": 19}, "all_disposition_status": {"const": "pending"}}},
    "panel_roles": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "protocol": {"type": "object", "additionalProperties": false, "required": ["first_passes_independent", "structured_claim_evidence_fields_required", "dissent_preserved", "orchestrator_may_grant_authority", "source_bytes_retained", "reviewer_identity_type", "human_review_status"], "properties": {"first_passes_independent": {"const": true}, "structured_claim_evidence_fields_required": {"const": true}, "dissent_preserved": {"const": true}, "orchestrator_may_grant_authority": {"const": false}, "source_bytes_retained": {"const": false}, "reviewer_identity_type": {"const": "software_agents"}, "human_review_status": {"const": "not_performed"}}},
    "source_assessment": {"type": "object", "additionalProperties": false, "required": ["receipt_artifact", "rights_status", "applicability_status", "source_authority"], "properties": {"receipt_artifact": {"const": "agent_observed_only"}, "rights_status": {"enum": ["confirmed_for_subset", "unresolved", "not_applicable"]}, "applicability_status": {"enum": ["provisional_narrow_scope_only", "unresolved", "not_applicable"]}, "source_authority": {"const": false}}},
    "provisional_conclusion": {"type": "string", "minLength": 1}, "prohibited_claims": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["agentic_review_complete", "eligible_human_review_complete", "human_confirmation", "scientific_acceptance", "source_authority", "runtime", "real_study", "publication", "release", "finding_disposition", "h8_d", "h8_e", "h8_f", "h8_g", "h8_h"], "properties": {"agentic_review_complete": {"const": true}, "eligible_human_review_complete": {"const": false}, "human_confirmation": {"const": false}, "scientific_acceptance": {"const": false}, "source_authority": {"const": false}, "runtime": {"const": false}, "real_study": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "finding_disposition": {"const": false}, "h8_d": {"const": false}, "h8_e": {"const": false}, "h8_f": {"const": false}, "h8_g": {"const": false}, "h8_h": {"const": false}}},
    "expiry": {"type": "object", "additionalProperties": false, "required": ["review_by", "supersede_on"], "properties": {"review_by": {"type": "string", "format": "date"}, "supersede_on": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
