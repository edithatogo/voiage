{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/frontier/value-of-flexibility-result.v1.json",
  "title": "ValueOfFlexibilityResultV1Experimental",
  "type": "object",
  "required": [
    "analysis_type", "method_maturity", "value_unit", "stage_semantics",
    "flexible_value", "constrained_value", "value_of_flexibility",
    "flexible_policy_path", "constrained_policy_path", "commitment_baseline",
    "information_value_component", "decomposition_status", "diagnostics", "reporting"
  ],
  "properties": {
    "analysis_type": {"const": "value_of_flexibility"},
    "method_maturity": {"const": "experimental"},
    "value_unit": {"type": "string", "minLength": 1},
    "stage_semantics": {"const": "timing_scenarios"},
    "flexible_value": {"type": "number"},
    "constrained_value": {"type": "number"},
    "value_of_flexibility": {"type": "number", "minimum": 0},
    "flexible_policy_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constrained_policy_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "commitment_baseline": {"type": "string", "minLength": 1},
    "waiting_value": {"type": ["number", "null"]},
    "option_value": {"type": "number", "minimum": 0},
    "information_value_component": {"const": 0},
    "decomposition_status": {"const": "information-value-excluded"},
    "exercise_decisions": {"type": "array", "minItems": 1, "items": {"type": "boolean"}},
    "policy_path_regret": {"type": "array"},
    "diagnostics": {"type": "object"},
    "reporting": {"type": "object"}
  },
  "additionalProperties": false
}
