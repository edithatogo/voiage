{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/schemas/frontier/belief-state-information-result.v1.json",
  "title": "BeliefStateInformationResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "analysis_type", "method_maturity", "value_unit", "time_unit", "objective_direction", "chronology", "horizon", "discount_factor", "policy_class", "model_assurance", "values", "value_by_horizon", "conditional_sensing_values", "policy_tree", "stopping", "approximation_bounds", "assurance", "language_dispositions", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_id": {"type": "string", "minLength": 1},
    "analysis_type": {"const": "belief_state_information_result"},
    "method_maturity": {"const": "experimental"},
    "value_unit": {"type": "string", "minLength": 1},
    "time_unit": {"type": "string", "minLength": 1},
    "objective_direction": {"enum": ["maximize", "minimize"]},
    "chronology": {"const": ["control", "transition", "observe", "update"]},
    "horizon": {"type": "integer", "minimum": 1},
    "discount_factor": {"type": "number"},
    "policy_class": {"const": "deterministic_markov_belief_policy"},
    "model_assurance": {"type": "object", "additionalProperties": false, "required": ["input_sha256", "input_contract"], "properties": {"input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "input_contract": {"$ref": "https://voiage.dev/schemas/frontier/belief-state-information-input.v1.json"}}},
    "values": {"type": "object", "additionalProperties": false, "required": ["closed_loop_gross", "expected_sensing_cost", "closed_loop_net", "no_information", "gross_information_value", "net_information_value", "myopic_information_value", "nonmyopic_information_value", "nonmyopic_minus_myopic", "fully_observed_value", "partial_observability_regret"], "properties": {"closed_loop_gross": {"type": "number"}, "expected_sensing_cost": {"type": "number"}, "closed_loop_net": {"type": "number"}, "no_information": {"type": "number"}, "gross_information_value": {"type": "number"}, "net_information_value": {"type": "number"}, "myopic_information_value": {"type": "number"}, "nonmyopic_information_value": {"type": "number"}, "nonmyopic_minus_myopic": {"type": "number"}, "fully_observed_value": {"type": "number"}, "partial_observability_regret": {"type": "number"}}},
    "value_by_horizon": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["horizon", "closed_loop_net", "no_information", "net_information_value"], "properties": {"horizon": {"type": "integer"}, "closed_loop_net": {"type": "number"}, "no_information": {"type": "number"}, "net_information_value": {"type": "number"}}}},
    "conditional_sensing_values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conditionalControl"}},
    "policy_tree": {"$ref": "#/$defs/policyNode"},
    "stopping": {"type": "object", "additionalProperties": false, "required": ["kind", "reason", "stage"], "properties": {"kind": {"const": "fixed_horizon"}, "reason": {"const": "horizon_reached"}, "stage": {"type": "integer"}}},
    "approximation_bounds": {"type": "object", "additionalProperties": false, "required": ["lower", "upper", "gap"], "properties": {"lower": {"type": "number"}, "upper": {"type": "number"}, "gap": {"type": "number"}}},
    "assurance": {"type": "object", "additionalProperties": false, "required": ["solver", "estimator", "exact_enumeration", "approximation_used", "posterior_martingale_verified", "posterior_martingale_max_residual", "null_sensor_reduction_verified", "no_information_reduction_verified", "complete_ties_reported", "action_dependent_transition", "action_dependent_learning", "usable_downstream_learning_response", "dual_control_diagnostic", "unique_additive_dual_control_value_claimed", "estimated_bellman_expansions", "exact_enumeration_budget"], "properties": {"solver": {"const": "exact_finite_horizon_bellman_enumeration"}, "estimator": {"const": "deterministic_exact"}, "exact_enumeration": {"const": true}, "approximation_used": {"const": false}, "posterior_martingale_verified": {"type": "boolean"}, "posterior_martingale_max_residual": {"type": "number", "minimum": 0}, "null_sensor_reduction_verified": {"type": "boolean"}, "no_information_reduction_verified": {"type": "boolean"}, "complete_ties_reported": {"type": "boolean"}, "action_dependent_transition": {"type": "boolean"}, "action_dependent_learning": {"type": "boolean"}, "usable_downstream_learning_response": {"type": "boolean"}, "dual_control_diagnostic": {"type": "boolean"}, "unique_additive_dual_control_value_claimed": {"const": false}, "estimated_bellman_expansions": {"type": "integer", "minimum": 1}, "exact_enumeration_budget": {"type": "integer", "minimum": 1}}},
    "language_dispositions": {"type": "object", "additionalProperties": false, "required": ["python", "rust", "r", "julia", "mojo"], "properties": {"python": {"const": "executable-experimental"}, "rust": {"const": "unsupported"}, "r": {"const": "unsupported"}, "julia": {"const": "unsupported"}, "mojo": {"const": "external-boundary"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "probabilityMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "stringTie": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policyBranch": {"type": "object", "additionalProperties": false, "required": ["observation_id", "probability", "posterior_belief", "continuation"], "properties": {"observation_id": {"type": "string", "minLength": 1}, "probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "posterior_belief": {"$ref": "#/$defs/probabilityMap"}, "continuation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/policyNode"}]}}},
    "policyNode": {"type": "object", "additionalProperties": false, "required": ["stage", "belief", "control_choice_tie", "selected_control", "sensor_choice_tie", "selected_sensor", "predictive_belief", "branches", "chronology"], "properties": {"stage": {"type": "integer", "minimum": 0}, "belief": {"$ref": "#/$defs/probabilityMap"}, "control_choice_tie": {"$ref": "#/$defs/stringTie"}, "selected_control": {"type": "string", "minLength": 1}, "sensor_choice_tie": {"$ref": "#/$defs/stringTie"}, "selected_sensor": {"type": "string", "minLength": 1}, "predictive_belief": {"$ref": "#/$defs/probabilityMap"}, "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policyBranch"}}, "chronology": {"const": ["control", "transition", "observe", "update"]}}},
    "conditionalSensor": {"type": "object", "additionalProperties": false, "required": ["sensor_id", "gross_value", "sensing_cost", "net_value", "net_increment_vs_null"], "properties": {"sensor_id": {"type": "string", "minLength": 1}, "gross_value": {"type": "number"}, "sensing_cost": {"type": "number", "minimum": 0}, "net_value": {"type": "number"}, "net_increment_vs_null": {"type": "number"}}},
    "conditionalControl": {"type": "object", "additionalProperties": false, "required": ["control_action_id", "sensors"], "properties": {"control_action_id": {"type": "string", "minLength": 1}, "sensors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conditionalSensor"}}}}
  }
}
