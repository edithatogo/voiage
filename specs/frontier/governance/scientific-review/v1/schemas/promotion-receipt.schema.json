{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://voiage.dev/specs/frontier/governance/scientific-review/v1/schemas/promotion-receipt.schema.json", "title": "ScientificPromotionReceiptV1", "type": "object",
  "required": ["evidence_kind", "schema_version", "receipt_id", "candidate_commit", "candidate_tree", "packet_sha256", "scope", "maintainer", "decision", "scientific_approval_sha256", "conditions", "dissent_refs", "issue_refs", "evidence_refs", "decision_at", "expires_at", "superseded_by", "receipt_sha256"],
  "properties": {
    "evidence_kind": {"const": "promotion-receipt"}, "schema_version": {"const": "1.0.0"}, "receipt_id": {"$ref": "common.schema.json#/$defs/nonempty"},
    "candidate_commit": {"$ref": "common.schema.json#/$defs/sha256"}, "candidate_tree": {"$ref": "common.schema.json#/$defs/sha256"}, "packet_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "scope": {"$ref": "common.schema.json#/$defs/scope"}, "maintainer": {"$ref": "common.schema.json#/$defs/reviewer"},
    "decision": {"enum": ["promote", "retain_experimental", "exclude"]}, "scientific_approval_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "conditions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}}, "dissent_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}}, "issue_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty"}},
    "decision_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "superseded_by": {"type": ["string", "null"], "minLength": 1}, "receipt_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }, "additionalProperties": false
}
