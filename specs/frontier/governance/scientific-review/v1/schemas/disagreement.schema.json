{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://voiage.dev/specs/frontier/governance/scientific-review/v1/schemas/disagreement.schema.json", "title": "ScientificReviewDisagreementV1", "type": "object",
  "required": ["evidence_kind", "schema_version", "disagreement_id", "candidate_commit", "candidate_tree", "packet_sha256", "topic", "positions", "scientific_validity_dissent", "resolution_evidence_required", "status", "recorded_at"],
  "properties": {
    "evidence_kind": {"const": "disagreement"}, "schema_version": {"const": "1.1.0"}, "disagreement_id": {"$ref": "common.schema.json#/$defs/nonempty"},
    "candidate_commit": {"$ref": "common.schema.json#/$defs/gitOid"}, "candidate_tree": {"$ref": "common.schema.json#/$defs/gitOid"}, "packet_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "topic": {"$ref": "common.schema.json#/$defs/nonempty"}, "positions": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["reviewer_identity", "position", "evidence_refs"], "properties": {"reviewer_identity": {"$ref": "common.schema.json#/$defs/nonempty"}, "position": {"$ref": "common.schema.json#/$defs/nonempty"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty"}}}, "additionalProperties": false}},
    "scientific_validity_dissent": {"type": "boolean"}, "resolution_evidence_required": {"$ref": "common.schema.json#/$defs/nonempty"}, "status": {"enum": ["open", "resolved", "accepted_experimental_dissent"]}, "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }, "additionalProperties": false
}
