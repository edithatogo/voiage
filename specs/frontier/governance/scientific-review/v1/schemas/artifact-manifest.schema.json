{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/frontier/governance/scientific-review/v1/schemas/artifact-manifest.schema.json",
  "title": "ScientificReviewArtifactManifestV1",
  "type": "object",
  "required": ["evidence_kind", "schema_version", "candidate_commit", "candidate_tree", "manifest_sha256", "artifacts"],
  "properties": {
    "evidence_kind": {"const": "artifact-manifest"},
    "schema_version": {"const": "1.1.0"},
    "candidate_commit": {"$ref": "common.schema.json#/$defs/gitOid"},
    "candidate_tree": {"$ref": "common.schema.json#/$defs/gitOid"},
    "manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "role": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
