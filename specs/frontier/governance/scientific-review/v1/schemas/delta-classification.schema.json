{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://voiage.dev/specs/frontier/governance/scientific-review/v1/schemas/delta-classification.schema.json", "title": "ScientificReviewDeltaClassificationV1", "type": "object",
  "required": ["evidence_kind", "schema_version", "classification_id", "candidate_commit", "candidate_tree", "packet_sha256", "base_candidate_commit", "base_packet_sha256", "classification", "changed_paths", "changed_artifact_hashes", "rationale", "affected_scope", "signatures", "classified_at"],
  "properties": {
    "evidence_kind": {"const": "delta-classification"}, "schema_version": {"const": "1.0.0"}, "classification_id": {"$ref": "common.schema.json#/$defs/nonempty"},
    "candidate_commit": {"$ref": "common.schema.json#/$defs/sha256"}, "candidate_tree": {"$ref": "common.schema.json#/$defs/sha256"}, "packet_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "base_candidate_commit": {"$ref": "common.schema.json#/$defs/sha256"}, "base_packet_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "classification": {"enum": ["full_invalidation", "bounded_metadata_only"]}, "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/nonempty"}},
    "changed_artifact_hashes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "before_sha256", "after_sha256"], "properties": {"path": {"$ref": "common.schema.json#/$defs/nonempty"}, "before_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "after_sha256": {"$ref": "common.schema.json#/$defs/sha256"}}, "additionalProperties": false}},
    "rationale": {"$ref": "common.schema.json#/$defs/nonempty"}, "affected_scope": {"$ref": "common.schema.json#/$defs/scope"}, "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/signature"}}, "classified_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }, "additionalProperties": false
}
