{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://voiage.dev/specs/frontier/governance/scientific-review/v1/schemas/adjudication.schema.json", "title": "ScientificReviewAdjudicationV1", "type": "object",
  "required": ["evidence_kind", "schema_version", "adjudication_id", "candidate_commit", "candidate_tree", "packet_sha256", "scope", "chair", "decision", "conditions", "dissent_refs", "issue_refs", "evidence_refs", "decision_at", "expires_at", "superseded_by", "adjudication_sha256", "human_receipt"],
  "properties": {
    "evidence_kind": {"const": "adjudication"}, "schema_version": {"const": "1.1.0"}, "adjudication_id": {"$ref": "common.schema.json#/$defs/nonempty"},
    "candidate_commit": {"$ref": "common.schema.json#/$defs/gitOid"}, "candidate_tree": {"$ref": "common.schema.json#/$defs/gitOid"}, "packet_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "scope": {"$ref": "common.schema.json#/$defs/scope"}, "chair": {"$ref": "common.schema.json#/$defs/reviewer"},
    "decision": {"enum": ["scientifically_acceptable_experimental", "conditional_remediation_and_rereview", "major_revision_and_full_rereview", "reviewed_exclusion"]},
    "conditions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}}, "dissent_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}}, "issue_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty"}},
    "decision_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "superseded_by": {"type": ["string", "null"], "minLength": 1}, "adjudication_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "human_receipt": {"$ref": "common.schema.json#/$defs/humanReceipt"}
  }, "additionalProperties": false
}
