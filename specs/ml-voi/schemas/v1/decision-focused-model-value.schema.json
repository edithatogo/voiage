{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/ml-voi/schemas/v1/decision-focused-model-value.schema.json",
  "title": "DecisionFocusedModelValueV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "evaluated_at",
    "candidate_models",
    "selected_model",
    "downstream_metrics",
    "refresh_recommendation"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_id", "expected_decision_value", "policy_regret"],
        "properties": {
          "model_id": { "type": "string" },
          "predictive_metric_score": { "type": "number" },
          "expected_decision_value": { "type": "number" },
          "policy_regret": { "type": "number" }
        }
      }
    },
    "selected_model": {
      "type": "string"
    },
    "downstream_metrics": {
      "type": "object",
      "required": ["max_decision_value", "min_policy_regret"],
      "properties": {
        "max_decision_value": { "type": "number" },
        "min_policy_regret": { "type": "number" },
        "value_of_model_upgrade": { "type": "number" }
      }
    },
    "refresh_recommendation": {
      "type": "object",
      "required": ["should_refresh", "rationale"],
      "properties": {
        "should_refresh": { "type": "boolean" },
        "rationale": { "type": "string" },
        "drift_threshold_exceeded": { "type": "boolean" }
      }
    }
  }
}
