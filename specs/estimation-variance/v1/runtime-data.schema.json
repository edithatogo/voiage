{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/estimation-variance/v1/runtime-data.schema.json",
  "title": "EstimationVarianceRuntimeDataV1",
  "oneOf": [
    {"$ref": "#/$defs/evppi_var"},
    {"$ref": "#/$defs/evsi_var"}
  ],
  "$defs": {
    "finite_values": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "evppi_var": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_samples", "conditioning_groups"],
      "properties": {
        "target_samples": {"$ref": "#/$defs/finite_values"},
        "conditioning_groups": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evsi_var": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_target_samples",
        "posterior_variances",
        "predictive_probabilities"
      ],
      "properties": {
        "prior_target_samples": {"$ref": "#/$defs/finite_values"},
        "posterior_variances": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "minimum": 0}
        },
        "predictive_probabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
