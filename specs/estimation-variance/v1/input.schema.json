{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/estimation-variance/v1/input.schema.json",
  "title": "EstimationVarianceSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_id",
    "target",
    "prior_model_id",
    "conditioning",
    "sampling_model",
    "estimator",
    "zero_variance_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "method_id": {"enum": ["evppi_var", "evsi_var"]},
    "target": {"$ref": "#/$defs/target"},
    "prior_model_id": {"type": "string", "minLength": 1},
    "conditioning": {
      "anyOf": [{"$ref": "#/$defs/conditioning"}, {"type": "null"}]
    },
    "sampling_model": {
      "anyOf": [{"$ref": "#/$defs/sampling_model"}, {"type": "null"}]
    },
    "estimator": {"$ref": "#/$defs/estimator"},
    "zero_variance_policy": {"const": "absolute_zero_relative_null"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_id",
        "shape",
        "component_units",
        "covariance_functional",
        "functional_weights"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "target_id": {"type": "string", "minLength": 1},
        "shape": {"enum": ["scalar", "vector"]},
        "component_units": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "covariance_functional": {
          "enum": ["variance", "trace", "determinant", "weighted_quadratic"]
        },
        "functional_weights": {
          "anyOf": [
            {"type": "array", "items": {"type": "number"}},
            {"type": "null"}
          ]
        }
      }
    },
    "conditioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_subset", "sigma_field", "averaging_convention"],
      "properties": {
        "parameter_subset": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sigma_field": {"type": "string", "minLength": 1},
        "averaging_convention": {
          "enum": ["prior_predictive", "posterior_predictive", "empirical_reference"]
        }
      }
    },
    "sampling_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_id",
        "likelihood_id",
        "conditioning_sigma_field",
        "averaging_convention"
      ],
      "properties": {
        "design_id": {"type": "string", "minLength": 1},
        "likelihood_id": {"type": "string", "minLength": 1},
        "conditioning_sigma_field": {"type": "string", "minLength": 1},
        "averaging_convention": {
          "enum": ["prior_predictive", "posterior_predictive", "empirical_reference"]
        }
      }
    },
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimator_id",
        "seed",
        "absolute_tolerance",
        "relative_tolerance",
        "bootstrap_replicates",
        "convergence_threshold"
      ],
      "properties": {
        "estimator_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "bootstrap_replicates": {"type": "integer", "minimum": 0},
        "convergence_threshold": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
