{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/estimation-variance/v1/result.schema.json",
  "title": "EstimationVarianceResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_id",
    "target",
    "prior_covariance",
    "expected_posterior_covariance",
    "prior_functional",
    "expected_posterior_functional",
    "raw_reduction",
    "absolute_reduction",
    "relative_reduction",
    "functional_units",
    "negative_estimate_policy",
    "zero_variance_policy",
    "diagnostics",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "method_id": {"enum": ["evppi_var", "evsi_var"]},
    "target": {"$ref": "#/$defs/target"},
    "prior_covariance": {"$ref": "#/$defs/covariance"},
    "expected_posterior_covariance": {"$ref": "#/$defs/covariance"},
    "prior_functional": {"type": "number", "minimum": 0},
    "expected_posterior_functional": {"type": "number", "minimum": 0},
    "raw_reduction": {"type": "number"},
    "absolute_reduction": {"type": "number", "minimum": 0},
    "relative_reduction": {
      "anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
    },
    "functional_units": {"type": "string", "minLength": 1},
    "negative_estimate_policy": {"const": "retain_raw_clip_reported"},
    "zero_variance_policy": {"const": "absolute_zero_relative_null"},
    "diagnostics": {"$ref": "#/$defs/diagnostics"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_id",
        "shape",
        "component_units",
        "covariance_functional",
        "functional_weights"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "target_id": {"type": "string", "minLength": 1},
        "shape": {"enum": ["scalar", "vector"]},
        "component_units": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "covariance_functional": {
          "enum": ["variance", "trace", "determinant", "weighted_quadratic"]
        },
        "functional_weights": {
          "anyOf": [
            {"type": "array", "items": {"type": "number"}},
            {"type": "null"}
          ]
        }
      }
    },
    "covariance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "number"}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_sample_count",
        "posterior_evaluation_count",
        "bootstrap_replicates",
        "monte_carlo_standard_error",
        "confidence_level",
        "confidence_interval",
        "converged",
        "diagnostic_codes"
      ],
      "properties": {
        "prior_sample_count": {"type": "integer", "minimum": 2},
        "posterior_evaluation_count": {"type": "integer", "minimum": 1},
        "bootstrap_replicates": {
          "type": "integer",
          "anyOf": [{"const": 0}, {"minimum": 2}]
        },
        "monte_carlo_standard_error": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "confidence_interval": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "minItems": 2,
              "maxItems": 2
            },
            {"type": "null"}
          ]
        },
        "converged": {"type": "boolean"},
        "diagnostic_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "kernel_version",
        "estimator_id",
        "seed",
        "specification_digest",
        "input_digest"
      ],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "kernel_version": {"type": "string", "minLength": 1},
        "estimator_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "specification_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
