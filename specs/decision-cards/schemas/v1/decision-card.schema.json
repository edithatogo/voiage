{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/decision-cards/schemas/v1/decision-card.schema.json",
  "title": "DecisionCardV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "version",
    "title",
    "status",
    "created_at",
    "decision_problem",
    "selected_policy",
    "information_valuation",
    "governance",
    "lineage"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Unique identifier for the decision record."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the decision card."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable executive title of the decision."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "approved", "superseded", "expired"],
      "description": "Lifecycle state of the decision."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp."
    },
    "decision_problem": {
      "type": "object",
      "required": ["problem_id", "title", "alternatives", "criterion"],
      "properties": {
        "problem_id": { "type": "string" },
        "title": { "type": "string" },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "criterion": { "type": "string" }
      }
    },
    "selected_policy": {
      "type": "object",
      "required": ["name", "rationale", "expected_net_benefit"],
      "properties": {
        "name": { "type": "string" },
        "rationale": { "type": "string" },
        "expected_net_benefit": { "type": "number" },
        "baseline_comparison": { "type": "string" }
      }
    },
    "information_valuation": {
      "type": "object",
      "required": ["evpi"],
      "properties": {
        "evpi": { "type": "number" },
        "evppi": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "evsi": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "enbs": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "recommended_information_action": { "type": "string" }
      }
    },
    "residual_uncertainty": {
      "type": "object",
      "properties": {
        "top_drivers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk_quantiles": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "sensitivity_summary": { "type": "string" }
      }
    },
    "governance": {
      "type": "object",
      "required": ["owner", "reviewers"],
      "properties": {
        "owner": { "type": "string" },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "human_approval": {
          "type": "object",
          "properties": {
            "approver": { "type": "string" },
            "approved_at": { "type": "string" },
            "rationale": { "type": "string" }
          }
        },
        "expiry_date": { "type": "string" },
        "refresh_cadence": { "type": "string" }
      }
    },
    "lineage": {
      "type": "object",
      "required": ["model_version", "input_hash"],
      "properties": {
        "model_version": { "type": "string" },
        "dataset_version": { "type": "string" },
        "code_version": { "type": "string" },
        "input_hash": { "type": "string" },
        "bundle_hash": { "type": "string" }
      }
    }
  }
}
