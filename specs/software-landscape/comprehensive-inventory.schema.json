{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiage.dev/specs/software-landscape/comprehensive-inventory.schema.json",
  "title": "VOIAGE comprehensive software landscape inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "reviewed_on",
    "review_due",
    "scope",
    "search_observations",
    "products"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "2.0.0"},
    "protocol_version": {"const": "1.0.0"},
    "reviewed_on": {"type": "string", "format": "date"},
    "review_due": {"type": "string", "format": "date"},
    "scope": {"type": "string", "minLength": 20},
    "search_observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/searchObservation"}
    },
    "products": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "searchObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "query",
        "source_url",
        "searched_at",
        "result",
        "candidate_product_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "channel": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 3},
        "source_url": {"$ref": "#/$defs/url"},
        "searched_at": {"type": "string", "format": "date-time"},
        "result": {
          "enum": [
            "candidates-found",
            "no-direct-product-found",
            "inaccessible"
          ]
        },
        "candidate_product_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "limitations": {"type": "string"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "aliases",
        "category",
        "maintenance",
        "availability",
        "inclusion",
        "duplicate_resolution",
        "rights",
        "versions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "category": {
          "enum": [
            "open-source",
            "commercial",
            "hosted",
            "embedded",
            "spreadsheet",
            "archived",
            "adjacent",
            "internal-reference"
          ]
        },
        "maintenance": {
          "enum": ["maintained", "limited", "archived", "unknown"]
        },
        "availability": {
          "enum": [
            "public-source",
            "public-binary",
            "public-documentation",
            "public-demonstration",
            "paid-or-private",
            "inaccessible"
          ]
        },
        "inclusion": {"$ref": "#/$defs/inclusion"},
        "duplicate_resolution": {"$ref": "#/$defs/duplicateResolution"},
        "rights": {"$ref": "#/$defs/rights"},
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/productVersion"}
        }
      }
    },
    "inclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "search_observation_ids"],
      "properties": {
        "decision": {"enum": ["include", "exclude", "defer"]},
        "reason": {"type": "string", "minLength": 10},
        "search_observation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "duplicateResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "canonical_product_id", "rationale"],
      "properties": {
        "relation": {
          "enum": [
            "canonical",
            "fork",
            "rename",
            "successor",
            "duplicate",
            "distinct"
          ]
        },
        "canonical_product_id": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "rationale": {"type": "string", "minLength": 5}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_state",
        "license_expression",
        "source_reuse",
        "reference_fixture_policy",
        "evidence_urls"
      ],
      "properties": {
        "review_state": {
          "enum": [
            "spdx-normalized",
            "custom-license",
            "ambiguous",
            "no-license",
            "proprietary",
            "unknown"
          ]
        },
        "license_expression": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "source_reuse": {
          "enum": ["permitted", "restricted", "prohibited", "unknown"]
        },
        "reference_fixture_policy": {
          "enum": ["independent-only", "repository-owned", "not-applicable"]
        },
        "evidence_urls": {
          "type": "array",
          "items": {"$ref": "#/$defs/url"}
        }
      }
    },
    "productVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "release_date",
        "reviewed_revision",
        "platforms",
        "languages",
        "install_and_deployment",
        "provenance_urls",
        "schema_surfaces",
        "capabilities",
        "adoption_lessons",
        "evidence_observations",
        "extraction_coverage",
        "limitations"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1},
        "release_date": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "reviewed_revision": {
          "oneOf": [
            {"type": "string", "minLength": 7},
            {"type": "null"}
          ]
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "install_and_deployment": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "provenance_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/url"}
        },
        "schema_surfaces": {
          "type": "array",
          "items": {"$ref": "#/$defs/schemaSurface"}
        },
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"}
        },
        "adoption_lessons": {
          "type": "array",
          "items": {"$ref": "#/$defs/adoptionLesson"}
        },
        "evidence_observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceObservation"}
        },
        "extraction_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/extractionCoverage"}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "schemaSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "format", "fields", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "data",
            "model",
            "uncertainty",
            "decision",
            "information-action",
            "utility",
            "risk-and-constraint",
            "study-design",
            "result",
            "report"
          ]
        },
        "format": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/schemaField"}
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "schemaField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "required", "default"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "default": {}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "canonical_ids",
        "parity_state",
        "subfeatures",
        "options",
        "defaults",
        "diagnostics",
        "errors",
        "interfaces",
        "artifacts",
        "evidence_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 2},
        "kind": {
          "enum": [
            "estimand",
            "estimator",
            "algorithm",
            "workflow",
            "visualization",
            "adapter",
            "application",
            "related-analysis"
          ]
        },
        "canonical_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "candidate_mapping": {
          "oneOf": [
            {"$ref": "#/$defs/candidateMapping"},
            {"type": "null"}
          ]
        },
        "parity_state": {
          "enum": [
            "native",
            "equivalent",
            "adapter",
            "planned",
            "excluded",
            "not-reproducible"
          ]
        },
        "subfeatures": {
          "type": "array",
          "items": {"$ref": "#/$defs/subfeature"}
        },
        "options": {
          "type": "array",
          "items": {"$ref": "#/$defs/option"}
        },
        "defaults": {
          "type": "array",
          "items": {"$ref": "#/$defs/defaultRecord"}
        },
        "diagnostics": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "interfaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "candidateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "classification"],
      "properties": {
        "record_id": {"$ref": "#/$defs/id"},
        "classification": {
          "enum": [
            "estimand",
            "estimator",
            "diagnostic",
            "alias",
            "application",
            "adjacent"
          ]
        }
      }
    },
    "subfeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 2},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value_type",
        "allowed_values",
        "default",
        "evidence_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 2},
        "value_type": {"type": "string", "minLength": 1},
        "allowed_values": {"type": "array"},
        "default": {},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "defaultRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value", "evidence_ids"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "value": {},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "adoptionLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "lesson", "user_roles", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "class": {
          "enum": [
            "onboarding",
            "workflow",
            "interaction",
            "reporting",
            "collaboration",
            "governance",
            "deployment",
            "integration",
            "accessibility",
            "industry-template"
          ]
        },
        "lesson": {"type": "string", "minLength": 10},
        "user_roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "evidenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "strength",
        "observability",
        "artifact_type",
        "source_url",
        "version_pin",
        "immutable",
        "reviewed_at",
        "rights_record_id",
        "observed_claims",
        "limitations"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "strength": {
          "enum": [
            "executable-version-pinned-source-and-tests",
            "version-pinned-source",
            "version-pinned-documentation",
            "public-observation",
            "vendor-claim",
            "inaccessible"
          ]
        },
        "observability": {
          "enum": [
            "inspectable",
            "documented",
            "observed",
            "claimed",
            "inaccessible"
          ]
        },
        "artifact_type": {
          "enum": [
            "source",
            "test",
            "example",
            "schema",
            "documentation",
            "release",
            "paper",
            "demonstration",
            "vendor-page",
            "archive"
          ]
        },
        "source_url": {"$ref": "#/$defs/url"},
        "version_pin": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "immutable": {"type": "boolean"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "rights_record_id": {"$ref": "#/$defs/id"},
        "observed_claims": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "extractionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "status", "evidence_ids", "notes"],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "observed",
            "absent",
            "unknown",
            "inaccessible",
            "not-applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
