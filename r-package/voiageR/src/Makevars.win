RUST_MANIFEST = rust/Cargo.toml
RUST_TARGET = rust/target
RUST_TRIPLE = x86_64-pc-windows-gnu
RUST_LIB = $(RUST_TARGET)/$(RUST_TRIPLE)/release/libvoiage_r_native.a

PKG_LIBS = $(RUST_LIB) -lws2_32 -luserenv -lbcrypt -lntdll

$(SHLIB): $(RUST_LIB)

$(RUST_LIB): $(RUST_MANIFEST) rust/Cargo.lock rust/src/lib.rs
	CARGO_TARGET_DIR=$(RUST_TARGET) cargo build --manifest-path $(RUST_MANIFEST) --target $(RUST_TRIPLE) --release --locked --offline

clean:
	$(RM) $(OBJECTS) $(SHLIB)
	cargo clean --manifest-path $(RUST_MANIFEST)
